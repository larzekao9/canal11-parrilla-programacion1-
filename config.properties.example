# Copiar a config.properties (ignorado por git) y completar. Tambien se puede usar variables de entorno
# con el mismo nombre en MAYUSCULAS y puntos como guion bajo (DB_PASSWORD, ADMIN_EMAIL, ...).
# Las variables de entorno tienen prioridad.

db.url=jdbc:postgresql://localhost:5432/canal_bd
db.user=postgres
db.password=CAMBIAR

# Administrador semilla (se crea solo si no existe ningun administrador)
admin.ci=00000000
admin.nombre=Admin
admin.apellido=Canal11
admin.email=admin@canal11.com
admin.password=CAMBIAR_MIN_8

# --- Correo (modo simulado por defecto: carpeta buzon-simulado/) ---
# mail.modo=real  usa el servidor de correo del curso (POP3 para leer, SMTP para responder)
mail.modo=simulado
mail.pop3.host=mail.tecnoweb.org.bo
mail.pop3.port=110
mail.user=grupo12sa
mail.password=CAMBIAR
# Directo desde la red de la facultad: mail.tecnoweb.org.bo:25
# Por tunel SSH (ssh -L 2525:mail.tecnoweb.org.bo:25 root@<ip_vps> -N): localhost:2525
mail.smtp.host=mail.tecnoweb.org.bo
mail.smtp.port=25
mail.from=grupo12sa@tecnoweb.org.bo

# --- Base de datos del servidor del curso (reemplaza los valores locales de arriba) ---
# db.url=jdbc:postgresql://db.tecnoweb.org.bo:5432/db_grupo12sa
# db.user=grupo12sa
# db.password=CAMBIAR

# Ventana de seguridad del buzon real: solo se examinan los ultimos N correos (el resto no se toca).
mail.ventana=200
# IMPORTANTE: admin.email debe ser el correo desde el que vas a ESCRIBIR los comandos (el sistema identifica al usuario por su email).
